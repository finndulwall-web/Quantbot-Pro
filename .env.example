# QuantBot Pro Environment Variables
# Copy this to .env and fill in your values

# Trading Mode: paper, live, backtest, walkforward
MODE=paper

# Trading Symbol
SYMBOL=BTC/USDT

# Capital in USDT
CAPITAL_USDT=170.0

# Risk Management
RISK_PER_TRADE=0.01
MAX_CONCURRENT_TRADES=3
MAX_PORTFOLIO_HEAT=1.0
MAX_DAILY_DRAWDOWN=0.05
MAX_TOTAL_DRAWDOWN=0.15

# Strategy Settings
RISK_PER_TRADE=0.01
MAX_CONCURRENT_TRADES=3
MAX_PORTFOLIO_HEAT=1.0
MAX_DAILY_DRAWDOWN=0.05
MAX_TOTAL_DRAWDOWN=0.15
KELLY_LOOKBACK=50
KELLY_MAX_FRACTION=0.25
MIN_CONFIDENCE=0.6
USE_MTF_CONFIRMATION=true

# Strategy Presets: safe, steady, bold
STRATEGY_PRESET=steady

# Technical Indicators
RSI_PERIOD=14
RSI_OVERSOLD=30
RSI_OVERBOUGHT=70
EMA_SHORT=20
EMA_MEDIUM=50
EMA_LONG=200
MACD_FAST=12
MACD_SLOW=26
MACD_SIGNAL=9
ATR_PERIOD=14
BB_PERIOD=20
BB_STD=2.0
ST_PERIOD=10
ST_MULT=3.0

# Trading Parameters
VOLUME_MULT=1.5
TP_ATR_MULT=2.0
SL_ATR_MULT=1.0
TRAIL_ATR_MULT=1.0

# Backtest Settings
BACKTEST_START=2023-01-01
BACKTEST_END=2024-01-01
TIMEFRAME=1h
LOOKBACK_CANDLES=200

# Optimization
OPTIMIZATION_ENABLED=true
WALKFORWARD_ENABLED=true
WF_TRAIN_DAYS=90
WF_TEST_DAYS=30
WF_STEP_DAYS=30
MIN_WIN_RATE=55
MAX_DRAWDOWN=10
MAX_OPT_ITERATIONS=5

# Slippage & Fees
SLIPPAGE_PCT=0.001
FEE_PCT=0.001

# API Keys (fill in your own)
WEBHOOK_URL=https://discord.com/api/webhooks/YOUR_WEBHOOK_HERE
NVIDIA_API_KEY=nvapi-your-api-key-here

# Render-specific
PORT=10000
RENDER=true
